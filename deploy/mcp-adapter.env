# Configuration of mcp-server-adapter. Fill in the empty values.
# No backend credential here: the gateway sends the user's own credential with every call.

# The server id: mcp-<system>, where <system> is the id the system has in the broker (2 to 31 lower case letters and digits, starting
# with a letter). Any such id works; the gateway derives it from the manifest, which says source: adapter.
MCP_SERVER_ID=

# The public key set of the gateway: https://<domain of the platform>/.well-known/mcp-jwks.json (the operator of the platform tells you
# the domain). The adapter has no policies: the policy data the gateway pushes is taken and not evaluated.
MCP_GATEWAY_JWKS_URI=

# Portal page for connecting an account, sent in credential_required; {system} is replaced by the server.
# Format: https://<portal>/connections?system={system}
MCP_CONNECT_URL=

# The foreign MCP server: its address (https, or http on a private network with MCP_FOREIGN_ALLOW_PLAIN_HTTP=true), the path of its
# MCP endpoint and how the user's credential becomes a header ({credential} exactly once).
MCP_FOREIGN_URL=
MCP_FOREIGN_PATH=/mcp
MCP_FOREIGN_AUTHORIZATION_FORMAT=Token {credential}
# Only for a server that refuses even tools/list without an Authorization header. Not a credential of anyone.
# MCP_FOREIGN_DISCOVERY_AUTHORIZATION=
# MCP_FOREIGN_ALLOW_PLAIN_HTTP=false
# MCP_FOREIGN_SSL_BUNDLE=

# Which tools of the foreign server to publish (comma separated, empty: all that can be bounded) and the prefix to remove from names.
MCP_ADAPTER_TOOLS_INCLUDE=
MCP_ADAPTER_STRIP_PREFIX=

MCP_ACCEPTED_CREDENTIAL_TYPES=user-secret

# Certificate of the server port. Leave these out and the adapter generates a self-signed certificate on its first start into the
# state volume and keeps it; it logs the fingerprint ("event=tls_certificate ... fingerprint=sha256:..."), which the operator compares
# with the one the portal shows before approving the connection. Your own certificate instead, files in certs/ (mounted at /certs):
# MCP_TLS_CERT=/certs/server.crt
# MCP_TLS_KEY=/certs/server.key
# or a PKCS12 keystore with its password:
# MCP_TLS_KEYSTORE=/certs/keystore.p12
# MCP_TLS_STORE_PASSWORD=
# No TLS at all, only inside the Docker network of the platform, and only if the operator allows http for this server:
# MCP_PLAIN_HTTP=true

# Several instances behind a balancer only. They need Redis for the one-time jti (otherwise a token could be used once on each
# instance) and the same Base64 key of the paging cursors (openssl rand -base64 32); the same certificate too (MCP_TLS_CERT, MCP_TLS_KEY).
# MCP_REDIS_HOST=
# MCP_REDIS_PORT=6379
# MCP_REDIS_USER=
# MCP_REDIS_PASSWORD=
# MCP_PAGING_CURSOR_KEY=
